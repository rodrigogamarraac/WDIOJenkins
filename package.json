{
  "name": "cucumber",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:chrome",
    "wdio": "wdio run ./wdio.conf.js",
    "test:chrome": "cross-env BROWSER=chrome wdio run ./wdio.conf.js",
    "test:edge": "cross-env BROWSER=edge wdio run ./wdio.conf.js",
    "test:crossbrowser": "cross-env BROWSER=all wdio run ./wdio.conf.js",
    "test:smoke": "cross-env TAGS=@smoke wdio run ./wdio.conf.js",
    "test:regression": "cross-env TAGS=@regression wdio run ./wdio.conf.js",
    "test:headless": "cross-env HEADLESS=true wdio run ./wdio.conf.js",
    "clean:allure": "rimraf allure-results allure-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report": "npm run allure:generate && npm run allure:open",
    "test:inciso1": "cross-env TAGS=@inciso1 wdio run ./wdio.conf.js",
    "test:inciso2": "cross-env TAGS=@inciso2 wdio run ./wdio.conf.js",
    "test:inciso3": "cross-env TAGS=@inciso3 wdio run ./wdio.conf.js",
    "test:inciso4": "cross-env TAGS=@inciso4 wdio run ./wdio.conf.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/cli": "^9.31.5",
    "@wdio/cucumber-framework": "^9.31.5",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/visual-service": "^10.1.0",
    "allure-commandline": "^2.43.0",
    "cross-env": "^7.0.3",
    "rimraf": "^6.1.3"
  }
}
